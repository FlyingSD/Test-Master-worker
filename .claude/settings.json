{
  "mcpServers": {
    "filesystem": {
      "command": "npm",
      "args": [
        "run",
        "fs-mcp"
      ],
      "env": {
        "ALLOWED_DIRECTORIES": "${workspaceFolder}"
      }
    },
    "wordpress": {
      "command": "npm",
      "args": [
        "run",
        "wp-mcp"
      ],
      "env": {
        "WP_PATH": "${workspaceFolder}",
        "DB_HOST": "localhost",
        "DB_NAME": "local",
        "DB_USER": "root",
        "DB_PASSWORD": "root"
      }
    }
  },
  "permissions": {
    "allowedTools": ["*"],
    "permissionMode": "allow"
  }
}
