{
  "name": "svetlinki-firebase-crm",
  "version": "1.0.0",
  "description": "Светлинки CRM - Modern Firebase-based Customer Relationship Management System",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:run": "vitest run",
    "test:watch": "vitest watch",
    "test:unit": "vitest run src/**/*.test.{ts,tsx}",
    "test:integration": "vitest run src/**/*.test.tsx",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "test:rules": "vitest run firestore.rules.test.ts",
    "test:all": "npm run test:run && npm run test:e2e && npm run test:rules",
    "test:ci": "npm run lint && npm run type-check && npm run test:run && npm run test:e2e",
    "deploy": "npm run build && firebase deploy",
    "migrate": "tsx migrate-students.ts",
    "migrate:live": "DRY_RUN=false tsx migrate-students.ts",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@tanstack/react-query": "^5.13.4",
    "@types/papaparse": "^5.5.0",
    "@types/qrcode": "^1.5.6",
    "@types/react-window": "^1.8.8",
    "chart.js": "^4.5.1",
    "clsx": "^2.0.0",
    "date-fns": "^3.0.6",
    "firebase": "^10.7.1",
    "gapi-script": "^1.2.0",
    "jspdf": "^3.0.3",
    "jspdf-autotable": "^5.0.2",
    "lucide-react": "^0.294.0",
    "papaparse": "^5.5.3",
    "qr-scanner": "^1.4.2",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-big-calendar": "^1.8.5",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^6.20.1",
    "react-window": "^2.2.3",
    "xlsx": "^0.18.5",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/glob": "^8.1.0",
    "@types/node": "^24.10.0",
    "@types/react": "^18.2.43",
    "@types/react-big-calendar": "^1.8.5",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^4.0.8",
    "@vitest/ui": "^4.0.8",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "glob": "^11.0.3",
    "happy-dom": "^20.0.10",
    "jsdom": "^27.1.0",
    "msw": "^2.12.1",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^5.0.8",
    "vitest": "^4.0.8"
  }
}
