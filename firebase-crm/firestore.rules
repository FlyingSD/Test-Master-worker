rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================
    // HELPER FUNCTIONS
    // ========================================

    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Get user data from users collection
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Check if user has specific role
    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }

    // Check if user is admin
    function isAdmin() {
      return hasRole('admin');
    }

    // Check if user is teacher
    function isTeacher() {
      return hasRole('teacher');
    }

    // Check if user is parent
    function isParent() {
      return hasRole('parent');
    }

    // Check if user is admin or teacher
    function isAdminOrTeacher() {
      return isAdmin() || isTeacher();
    }

    // Check if user owns the document (createdBy field)
    function ownsDocument() {
      return resource.data.createdBy == request.auth.uid;
    }

    // Check if user can modify document (admin or owner)
    function canModifyDocument() {
      return isAdmin() || ownsDocument();
    }

    // Check if parent has access to student (updated for parentIds array in student)
    function parentHasStudent(studentId) {
      return isParent() && (
        studentId in getUserData().studentIds ||
        request.auth.uid in get(/databases/$(database)/documents/students/$(studentId)).data.parentIds
      );
    }

    // Check if teacher teaches student's group
    function teacherTeachesGroup(groupId) {
      return isTeacher() && groupId in getUserData().groups;
    }

    // ========================================
    // 🔒 FIELD VALIDATION FUNCTIONS (CRITICAL #10 FIX)
    // ========================================

    // Validate string field: not null, is string, not empty
    function isValidString(value) {
      return value != null && value is string && value.size() > 0;
    }

    // Validate optional string: null or valid string
    function isValidOptionalString(value) {
      return value == null || (value is string && value.size() > 0);
    }

    // Validate number field: not null, is number
    function isValidNumber(value) {
      return value != null && value is number;
    }

    // Validate positive number: number >= 0
    function isPositiveNumber(value) {
      return isValidNumber(value) && value >= 0;
    }

    // Validate strictly positive number: number > 0
    function isStrictlyPositive(value) {
      return isValidNumber(value) && value > 0;
    }

    // Validate timestamp
    function isValidTimestamp(value) {
      return value != null && value is timestamp;
    }

    // Validate boolean
    function isValidBoolean(value) {
      return value != null && value is bool;
    }

    // Validate enum: value is in allowed list
    function isInEnum(value, allowedValues) {
      return value != null && value in allowedValues;
    }

    // Validate array: not null, is list
    function isValidArray(value) {
      return value != null && value is list;
    }


    // ========================================
    // USERS COLLECTION
    // ========================================
    match /users/{userId} {
      // Users can read their own profile
      // Admins can read all profiles
      // Teachers can read all profiles (to see students/parents)
      allow read: if isAuthenticated() && (
        request.auth.uid == userId ||
        isAdmin() ||
        isTeacher()
      );

      // Allow user creation:
      // 1. Admins can create any user
      // 2. Authenticated users can create their own parent account (self-registration)
      allow create: if isAdmin() ||
        (
          isAuthenticated() &&
          request.auth.uid == userId &&
          request.resource.data.role == 'parent'
        );

      // Users can update their own profile (but not role!)
      // Admins can update any profile
      // Parents can update their studentIds array (for linking children)
      allow update: if isAuthenticated() && (
        (
          request.auth.uid == userId &&
          request.resource.data.role == resource.data.role
        ) ||
        isAdmin()
      );

      // Only admins can delete users
      allow delete: if isAdmin();
    }


    // ========================================
    // STUDENTS COLLECTION
    // ========================================
    match /students/{studentId} {
      // 🔒 Field validation for students
      function isValidStudent(data) {
        return isValidString(data.name) &&
               isValidString(data.studentCode) &&
               data.studentCode.size() == 6 &&
               isValidString(data.group) &&
               isPositiveNumber(data.fee) &&
               isPositiveNumber(data.feeEUR) &&
               isValidTimestamp(data.dueDate) &&
               isInEnum(data.status, ['active', 'inactive']) &&
               isInEnum(data.studyType, ['Групово', 'Индивидуално']) &&
               isValidArray(data.parentIds) &&
               isValidOptionalString(data.notes) &&
               isValidString(data.createdBy) &&
               isValidTimestamp(data.createdAt);
      }

      // Read access:
      // - Admins: see all students
      // - Teachers: see ONLY students in their assigned groups (GDPR compliant)
      // - Parents: see ONLY their children
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (isTeacher() && teacherTeachesGroup(resource.data.group)) ||
        parentHasStudent(studentId)
      );

      // Create: Only admins and teachers with field validation
      allow create: if isAdminOrTeacher() &&
        request.resource.data.createdBy == request.auth.uid &&
        isValidStudent(request.resource.data);

      // Update: Admins or owner (teacher must teach the student's group) with field validation
      // TODO: Implement parent self-linking with student code verification
      // For now, parents must be linked by admin/teacher for security
      allow update: if (isAdmin() ||
        (isTeacher() && ownsDocument() && teacherTeachesGroup(resource.data.group))) &&
        isValidStudent(request.resource.data);

      // Delete: Only admins or owner
      allow delete: if canModifyDocument();
    }


    // ========================================
    // PAYMENTS COLLECTION
    // ========================================
    match /payments/{paymentId} {
      // 🔒 Field validation for payments
      function isValidPayment(data) {
        return isValidString(data.studentId) &&
               isValidString(data.studentName) &&
               isStrictlyPositive(data.amount) &&
               isInEnum(data.method, ['Кеш', 'ПОС', 'Банков път', 'Фактура']) &&
               isInEnum(data.article, ['', 'Абакус', 'Учебна тетрадка', 'Други']) &&
               isValidTimestamp(data.date) &&
               isValidOptionalString(data.notes) &&
               isValidOptionalString(data.receiptNumber) &&
               isValidString(data.createdBy) &&
               isValidTimestamp(data.createdAt);
      }

      // Read access:
      // - Admins: see all payments
      // - Teachers: see all payments (for class management)
      // - Parents: see ONLY payments for their children
      allow read: if isAuthenticated() && (
        isAdmin() ||
        isTeacher() ||
        (isParent() && parentHasStudent(resource.data.studentId))
      );

      // Create: Only admins and teachers with field validation
      allow create: if isAdminOrTeacher() &&
        request.resource.data.createdBy == request.auth.uid &&
        isValidPayment(request.resource.data);

      // Update: Only admins or owner with field validation
      allow update: if canModifyDocument() &&
        isValidPayment(request.resource.data);

      // Delete: Only admins or owner
      allow delete: if canModifyDocument();
    }


    // ========================================
    // EXPENSES COLLECTION
    // ========================================
    match /expenses/{expenseId} {
      // 🔒 Field validation for expenses
      function isValidExpense(data) {
        return isInEnum(data.category, ['Наем', 'Ток', 'Вода', 'Интернет', 'Заплати', 'Материали', 'Реклама', 'Други']) &&
               isStrictlyPositive(data.amount) &&
               isValidString(data.description) &&
               isValidTimestamp(data.date) &&
               isValidOptionalString(data.receiptNumber) &&
               isValidString(data.createdBy) &&
               isValidTimestamp(data.createdAt);
      }

      // Read: Only admins and teachers
      allow read: if isAdminOrTeacher();

      // Create: Only admins and teachers with field validation
      allow create: if isAdminOrTeacher() &&
        request.resource.data.createdBy == request.auth.uid &&
        isValidExpense(request.resource.data);

      // Update: Only admins or owner with field validation
      allow update: if canModifyDocument() &&
        isValidExpense(request.resource.data);

      // Delete: Only admins or owner
      allow delete: if canModifyDocument();
    }


    // ========================================
    // EVENTS COLLECTION
    // ========================================
    match /events/{eventId} {
      // Read: Everyone authenticated (parents need to see schedule)
      allow read: if isAuthenticated();

      // Create: Only admins and teachers
      allow create: if isAdminOrTeacher() &&
        request.resource.data.createdBy == request.auth.uid;

      // Update: Only admins or owner
      allow update: if canModifyDocument();

      // Delete: Only admins or owner
      allow delete: if canModifyDocument();
    }


    // ========================================
    // HOMEWORK COLLECTION
    // ========================================
    match /homework/{homeworkId} {
      // 🔒 Field validation for homework
      function isValidHomework(data) {
        return isValidString(data.studentId) &&
               isValidString(data.studentName) &&
               isValidString(data.title) &&
               isValidString(data.description) &&
               isValidTimestamp(data.assignedDate) &&
               isValidTimestamp(data.dueDate) &&
               isInEnum(data.status, ['assigned', 'completed', 'overdue']) &&
               isValidOptionalString(data.teacherNotes) &&
               isValidOptionalString(data.parentNotes) &&
               isValidString(data.createdBy) &&
               isValidTimestamp(data.createdAt);
      }

      // Read access:
      // - Admins: see all homework
      // - Teachers: see homework they created
      // - Parents: see ONLY homework for their children
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (isTeacher() && ownsDocument()) ||
        (isParent() && parentHasStudent(resource.data.studentId))
      );

      // Create: Only admins and teachers with field validation
      allow create: if isAdminOrTeacher() &&
        request.resource.data.createdBy == request.auth.uid &&
        isValidHomework(request.resource.data);

      // Update: Only admins or owner (teachers who created it) with field validation
      allow update: if canModifyDocument() &&
        isValidHomework(request.resource.data);

      // Delete: Only admins or owner
      allow delete: if canModifyDocument();
    }


    // ========================================
    // ATTENDANCE COLLECTION
    // ========================================
    match /attendance/{attendanceId} {
      // Read access:
      // - Admins: see all attendance
      // - Teachers: see all attendance
      // - Parents: see ONLY their children's attendance
      allow read: if isAuthenticated() && (
        isAdmin() ||
        isTeacher() ||
        (isParent() && parentHasStudent(resource.data.studentId))
      );

      // Create: Only admins and teachers
      allow create: if isAdminOrTeacher() &&
        request.resource.data.createdBy == request.auth.uid;

      // Update: Only admins or owner
      allow update: if canModifyDocument();

      // Delete: Only admins or owner
      allow delete: if canModifyDocument();
    }


    // ========================================
    // DISCOUNTS COLLECTION
    // ========================================
    match /discounts/{discountId} {
      // Read access:
      // - Admins: see all discounts
      // - Teachers: see all discounts
      // - Parents: see ONLY discounts for their children
      allow read: if isAuthenticated() && (
        isAdmin() ||
        isTeacher() ||
        (isParent() && parentHasStudent(resource.data.studentId))
      );

      // Create: Only admins and teachers
      allow create: if isAdminOrTeacher() &&
        request.resource.data.createdBy == request.auth.uid;

      // Update: Only admins or owner
      allow update: if canModifyDocument();

      // Delete: Only admins or owner
      allow delete: if canModifyDocument();
    }


    // ========================================
    // PARENTS COLLECTION
    // ========================================
    match /parents/{parentId} {
      // Read access:
      // - Admins: see all parents
      // - Teachers: see all parents (for communication)
      // - Parents: see ONLY their own record
      allow read: if isAuthenticated() && (
        isAdmin() ||
        isTeacher() ||
        (isParent() && getUserData().id == parentId)
      );

      // Create: Only admins and teachers
      allow create: if isAdminOrTeacher() &&
        request.resource.data.createdBy == request.auth.uid;

      // Update: Only admins or owner
      allow update: if canModifyDocument();

      // Delete: Only admins or owner
      allow delete: if canModifyDocument();
    }


    // ========================================
    // INVOICES COLLECTION
    // ========================================
    match /invoices/{invoiceId} {
      // Read access:
      // - Admins: see all invoices
      // - Teachers: see all invoices
      // - Parents: see ONLY their invoices
      allow read: if isAuthenticated() && (
        isAdmin() ||
        isTeacher() ||
        (isParent() && resource.data.parentId == getUserData().id)
      );

      // Create: Only admins and teachers
      allow create: if isAdminOrTeacher() &&
        request.resource.data.createdBy == request.auth.uid;

      // Update: Only admins
      allow update: if isAdmin();

      // Delete: Only admins
      allow delete: if isAdmin();
    }


    // ========================================
    // INVENTORY COLLECTION
    // ========================================
    match /inventory/{itemId} {
      // 🔒 Field validation for inventory items
      function isValidInventory(data) {
        return isValidString(data.name) &&
               isValidString(data.sku) &&
               isInEnum(data.category, ['Абакуси', 'Учебници', 'Тетрадки', 'Материали', 'Други']) &&
               isValidOptionalString(data.description) &&
               isPositiveNumber(data.purchasePrice) &&
               isPositiveNumber(data.salePrice) &&
               isPositiveNumber(data.currentStock) &&
               isPositiveNumber(data.minimumStock) &&
               isValidOptionalString(data.location) &&
               isValidOptionalString(data.supplier) &&
               isValidBoolean(data.isActive) &&
               isValidString(data.createdBy) &&
               isValidTimestamp(data.createdAt);
      }

      // Read: Only admins and teachers
      allow read: if isAdminOrTeacher();

      // Create: Only admins and teachers with field validation
      allow create: if isAdminOrTeacher() &&
        request.resource.data.createdBy == request.auth.uid &&
        isValidInventory(request.resource.data);

      // Update: Only admins or owner with field validation
      allow update: if canModifyDocument() &&
        isValidInventory(request.resource.data);

      // Delete: Only admins or owner
      allow delete: if canModifyDocument();
    }


    // ========================================
    // STOCK_TRANSACTIONS COLLECTION
    // ========================================
    match /stock_transactions/{transactionId} {
      // 🔒 Field validation for stock transactions
      function isValidStockTransaction(data) {
        return isValidString(data.inventoryItemId) &&
               isValidString(data.inventoryItemName) &&
               isInEnum(data.type, ['IN', 'OUT']) &&
               isStrictlyPositive(data.quantity) &&
               isPositiveNumber(data.pricePerUnit) &&
               isPositiveNumber(data.totalPrice) &&
               isInEnum(data.reason, ['Покупка от доставчик', 'Продажба на ученик', 'Брак', 'Инвентаризация', 'Друго']) &&
               isValidOptionalString(data.notes) &&
               isValidString(data.createdBy) &&
               isValidTimestamp(data.createdAt);
      }

      // Read: Only admins and teachers
      allow read: if isAdminOrTeacher();

      // Create: Only admins and teachers with field validation
      allow create: if isAdminOrTeacher() &&
        request.resource.data.createdBy == request.auth.uid &&
        isValidStockTransaction(request.resource.data);

      // Update: No updates allowed (transactions are immutable)
      allow update: if false;

      // Delete: Only admins
      allow delete: if isAdmin();
    }


    // ========================================
    // GROUPS COLLECTION
    // ========================================
    match /groups/{groupId} {
      // 🔒 Field validation for groups
      function isValidGroup(data) {
        return isValidString(data.name) &&
               isValidOptionalString(data.description) &&
               isPositiveNumber(data.price) &&
               isPositiveNumber(data.currentStudents) &&
               isInEnum(data.status, ['active', 'inactive', 'archived']) &&
               isValidOptionalString(data.notes) &&
               isValidString(data.createdBy) &&
               isValidTimestamp(data.createdAt);
      }

      // Read: Everyone authenticated (students/parents need to see group info)
      allow read: if isAuthenticated();

      // Create: Only admins and teachers with field validation
      allow create: if isAdminOrTeacher() &&
        request.resource.data.createdBy == request.auth.uid &&
        isValidGroup(request.resource.data);

      // Update: Only admins or owner (teacher who created it) with field validation
      // Teachers cannot change price, priceEUR, teacherId, teacherName
      allow update: if canModifyDocument() &&
        isValidGroup(request.resource.data) && (
        isAdmin() ||
        (
          isTeacher() &&
          ownsDocument() &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['price', 'priceEUR', 'teacherId', 'teacherName'])
        )
      );

      // Delete: Only admins
      allow delete: if isAdmin();
    }


    // ========================================
    // SETTINGS COLLECTION (Labels, Config, etc.)
    // ========================================
    match /settings/{docId} {
      // Read: All authenticated users (everyone needs to see labels)
      allow read: if isAuthenticated();

      // Write: Only admins (labels, system config, etc.)
      allow write: if isAdmin();
    }


    // ========================================
    // DEFAULT DENY ALL
    // ========================================
    // Any collection not explicitly defined above is denied
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
